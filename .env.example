# ============================================================
# SI Inventory Barang Adiwiyata - Konfigurasi Database
# ============================================================
# Salin file ini menjadi .env, lalu isi sesuai hosting Anda.
# File .env TIDAK boleh di-commit ke Git (sudah ada di .gitignore).
# ============================================================

# Host database (biasanya localhost di hosting shared)
DB_HOST=localhost

# Port MySQL (default 3306)
DB_PORT=3306

# Username database hosting Anda
DB_USER=root

# Password database hosting Anda
DB_PASS=

# Nama database yang sudah dibuat di hosting
DB_NAME=inventory
