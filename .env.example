# ==============================================================================
# INVENTORY SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env di server production Anda:
# cp .env.example .env
# Jangan pernah commit file .env asli ke repositori git!
# ==============================================================================

# Application Environment (production / development / testing)
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/inventory_test

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory
DB_USER=root
DB_PASS=

# CI/CD & Webhook Deployment Security
# Gunakan string acak minimal 32 karakter untuk DEPLOY_SECRET.
# Nilai ini harus sama dengan DEPLOY_SECRET di GitHub Secrets / Webhook.
DEPLOY_SECRET=change_this_to_a_secure_random_secret_string_32_chars

# Git Deployment Branch
DEPLOY_BRANCH=main
